#!/bin/sh

alt="Mod1"
super="Mod4"

$XDG_CONFIG_HOME/bash/env

#########
# Style #
#########

# Window border.
riverctl border-color-focused   0x79740e
riverctl border-color-unfocused 0x282828
riverctl border-color-urgent    0x9d0006
riverctl border-width           2

# Layout.
riverctl attach-mode    top
riverctl default-layout rivertile

##########
# Ouputs #
##########

# Output focusing.
riverctl map normal $super       Period focus-output next
riverctl map normal $super       Comma  focus-output previous
riverctl map normal $super+Shift Period send-to-output next
riverctl map normal $super+Shift Comma  send-to-output previous

# Window focusing.
riverctl map normal $super       J      focus-view next
riverctl map normal $super       K      focus-view previous
riverctl map normal $super+Shift J      swap next
riverctl map normal $super+Shift K      swap previous
riverctl map normal $super       Return zoom

# Window sizing.
riverctl map         normal $super       H         send-layout-cmd rivertile "main-ratio -0.05"
riverctl map         normal $super       L         send-layout-cmd rivertile "main-ratio +0.05"
riverctl map         normal $super+Shift H         send-layout-cmd rivertile "main-count +1"
riverctl map         normal $super+Shift L         send-layout-cmd rivertile "main-count -1"
riverctl map-pointer normal $super       BTN_LEFT  move-view
riverctl map-pointer normal $super       BTN_RIGHT resize-view

##########
# Inputs #
##########

# Keyboards.
riverctl set-repeat 50 300

# Pointers.
pointer_inputs=$(riverctl list-inputs | grep "pointer")
for input in $pointer_inputs
do
  riverctl input $input click-method         clickfinger
  riverctl input $input drag                 enabled
  riverctl input $input disable-while-typing disabled
  riverctl input $input middle-emulation     disabled
  riverctl input $input natural-scroll       enabled
  riverctl input $input left-handed          disabled
  riverctl input $input tap                  enabled
  riverctl input $input tap-button-map       left-right-middle
  riverctl input $input scroll-method        two-finger
done 

##################
# Software: main #
##################

# System control.
riverctl map normal $super+Control L spawn \
  "waylock -init-color 0x79740e -input-color 0xb57614 -fail-color 0x9d0006"
riverctl map normal $super+Control Z spawn $XDG_CONFIG_HOME/river/config
riverctl map normal $super+Control R spawn reboot
riverctl map normal $super+Control Q spawn poweroff
riverctl map normal $super+Control E exit

# Software control.
riverctl map normal $super       F toggle-fullscreen
riverctl map normal $super+Shift F toggle-float
riverctl map normal $super       Q close

# Software shortcuts.
riverctl map normal $super Space spawn bemenu-run
riverctl map normal $super P     spawn menu-bw
riverctl map normal $super B     spawn zen-browser
riverctl map normal $super M     spawn thunderbird
riverctl map normal $super T     spawn "$TERMINAL"
riverctl map normal $super E     spawn "$TERMINAL -e lf"
riverctl map normal $super C     spawn "$TERMINAL -e qalc"
riverctl map normal $super W     spawn "$TERMINAL -e weather"

#######################
# Software: secondary #
#######################

# Screenshot.
riverctl map normal None          Print spawn "screen shot --copy"
riverctl map normal Control       Print spawn "screen shot --copy --crop"
riverctl map normal Shift         Print spawn "screen shot"
riverctl map normal Control+Shift Print spawn "screen shot --crop"

# Screen recording.
riverctl map normal $super         F2 spawn "screen record"
riverctl map normal $super+Control F2 spawn "screen record --crop"

for mode in normal locked
do

  # Notification control.
  riverctl map $mode Control+Shift Escape    spawn "makoctl dismiss --all"
  riverctl map $mode Control+Shift Backspace spawn "makoctl dismiss"
  riverctl map $mode Control+Shift Return    spawn "makoctl invoke"

  # Volume.
  riverctl map $mode None  XF86AudioRaiseVolume spawn "volume output increase"
  riverctl map $mode None  XF86AudioLowerVolume spawn "volume output decrease"
  riverctl map $mode None  XF86AudioMute        spawn "volume output mute"
  riverctl map $mode Shift XF86AudioRaiseVolume spawn "volume input increase"
  riverctl map $mode Shift XF86AudioLowerVolume spawn "volume input decrease"
  riverctl map $mode Shift XF86AudioMute        spawn "volume input mute"

  # Brightness.
  riverctl map $mode None XF86MonBrightnessUp   spawn \
    "brightnessctl set 10%+ -m | awk -F, '{print \$4}' | tr -d '%' > $WOBSOCK"
  riverctl map $mode None XF86MonBrightnessDown spawn \
    "brightnessctl set 10%- -m | awk -F, '{print \$4}' | tr -d '%' > $WOBSOCK"
done

########
# Misc #
########

# Tags.
all_tags=$((( 1 << 9 ) - 1))
riverctl map normal $super       0 set-focused-tags $all_tags
riverctl map normal $super+Shift 0 set-view-tags    $all_tags
for i in $(seq 1 9)
do
  tags=$((1 << ($i - 1)))
  riverctl map normal $super       $i set-focused-tags $tags
  riverctl map normal $super+Shift $i set-view-tags    $tags
done

# Cursor.
riverctl xcursor-theme        "$XCURSOR_THEME"
riverctl focus-follows-cursor disabled
riverctl set-cursor-warp      on-output-change

# Passthrough mode.
riverctl declare-mode passthrough
riverctl map normal      $super F11 enter-mode passthrough
riverctl map passthrough $super F11 enter-mode normal

# Fix borders for GTK windows.
# https://codeberg.org/river/wiki#some-windows-don-t-have-borders
for app in \
  imv \
  libreoffice-calc \
  libreoffice-startcenter \
  org.pulseaudio.pavucontrol \
  steam \
  thunderbird \
  zen
do
  riverctl rule-add -app-id "$app" ssd
done
