#!/bin/sh

file_path="$1"
width="$2"
height="$3"
pos_x="$4"
pos_y="$5"

show_image () {
  chafa -f sixel -s "$(($width-2))x$height" "$file_path" | sed 's/#/\n#/g'
}

cache_path="${XDG_CACHE_HOME:-$HOME/.cache}/lf"
[ ! -d $cache_path ] && mkdir --parents $cache_path

thumb_path=$( \
  printf "$cache_path/thumb-%s" "$( \
    stat --printf '%n\0%i\0%F\0%s\0%W\0%Y' -- "$(readlink -f "$file_path")" | \
      sha256sum | \
      cut -d' ' -f1 \
  )" \
)

case "$(file --dereference --brief --mime-type -- "$file_path")" in
  image/*) show_image ;;
  text/* | */xml | application/json) bat --terminal-width "$(($width-2))" -f "$file_path" ;;
  audio/* | application/octet-stream) mediainfo "$file_path" ;;
  video/*)
    [ ! -f "$thumb_path" ] && ffmpegthumbnailer -i "$file_path" -o "$thumb_path" -s 0
    show_image
    ;;
  */pdf)
    [ ! -f "$thumb_path.jpg" ] && pdftoppm -jpeg -f 1 -singlefile "$file_path" "$thumb_path"
    show_image
    ;;
  */epub+zip | */mobi*)
    [ ! -f "$thumb_path.jpg" ] && gnome-epub-thumbnailer "$file_path" "$thumb_path.jpg"
    show_image
    ;;
  *opendocument*) odt2txt "$file_path" ;;
  # Currently not used:
  # text/troff) man ./ "$file_path" | col -b ;;
  # application/pgp-encrypted) gpg -d -- "$file_path" ;;
  # text/html) lynx -width="$width" -display_charset=utf-8 -dump "$file_path" ;;
  # application/*zip) atool --list -- "$file_path" ;;
esac

exit 0
