#!/bin/sh

last_volume=""
last_muted=""

while true
do

  volume="$(ponymix --output get-volume)"
  muted="$(ponymix --output is-muted && echo true || echo false)"

  if [ "$volume" != "$last_volume" ] || [ "$muted" != "$last_muted" ]
  then
    last_volume="$volume"
    echo "volume|range:0-150|$volume"
    last_muted="$muted"
    echo "muted|bool|$muted"
    echo
  fi

  sleep 1
done
