#!/bin/sh

last_percent=""
last_usage=""

while true
do

  raw="$(df -ah --output=source,pcent,used "/dev/nvme0n1p3")"
  percent="$(echo $raw | awk '{ print $2 }' | tr -d %)"
  usage="$(echo $raw | awk '{ print $3 }')"

  if [ "$percent" != "$last_percent" ] || [ "$usage" != "$last_usage" ]
  then
    last_percent="$percent"
    echo "percent|range:0-100|$percent"
    last_usage="$usage"
    echo "usage|string|$usage"
    echo
  fi

  sleep 60
done
