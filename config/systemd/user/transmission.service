[Unit]
Description=transmission
AssertPathIsDirectory=%h/downloads/torrents/results
AssertPathIsDirectory=%h/downloads/torrents/in-progress

[Service]
Type=notify
ExecStartPre=/usr/bin/cp %E/transmission-daemon/settings.json \
  %S/transmission/settings.json
ExecStart=/usr/bin/transmission-daemon -f --log-level=error \
  --config-dir %S/transmission \
  --rpc-bind-address unix:%t/transmission/transmission.sock
ExecStartPost=+/usr/bin/ln -sfn transmission/transmission.sock \
  %t/transmission.sock
ExecStopPost=+/usr/bin/rm -f %t/transmission.sock
ExecReload=/bin/kill -s HUP $MAINPID
RuntimeDirectory=transmission
RuntimeDirectoryMode=0700
StateDirectory=transmission
StateDirectoryMode=0700
NoNewPrivileges=true
MemoryDenyWriteExecute=true
PrivateUsers=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/downloads/torrents
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=true
LockPersonality=true
SystemCallFilter=@system-service
SystemCallArchitectures=native

[Install]
WantedBy=default.target
