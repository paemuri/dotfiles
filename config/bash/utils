#!/bin/bash

alias cp="cp -v"
alias mv="mv -v"
alias less="less --RAW-CONTROL-CHARS"
alias ls="ls --almost-all --classify --color=auto"
alias grep="grep --color=auto"
alias watch="watch --color --beep --no-title --no-wrap"
alias pacman="pacman --color=auto"
alias killall-withfire="pkill -KILL -f --"
alias open=xdg-open
alias rm=trash
alias unrar=unrar-free
alias ssh="$SSH_COMMAND"
alias scp="scp -F $SSH_CONFIG"
alias sftp="sftp -F $SSH_CONFIG"
alias streamlink="streamlink --player=mpv"
alias scanimage=" \
  scanimage \
    --device=$SANE_DEFAULT_DEVICE \
    -x210 \
    -y297 \
    --resolution=300 \
    --format=pdf \
    --progress \
"

gdiff() {
  preview_args=''
  if test "$#" -gt 0
  then
    preview_args="$(printf '%q ' "$@")"
  fi
  git diff "$@" --name-only |
    fzf -m --ansi --preview "git diff ${preview_args} --color=always -- {-1}"
}
