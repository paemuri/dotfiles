#!/bin/sh

alias cp="cp -v"
alias mv="mv -v"
alias less="less --RAW-CONTROL-CHARS"
alias ls="ls --almost-all --classify --color=auto"
alias grep="grep --color=auto"
alias egrep="egrep --color=auto"
alias fgrep="fgrep --color=auto"
alias watch="watch --color --beep --no-title --no-wrap"
alias pacman="pacman --color=auto"
alias killall-withfire="pkill -KILL -f --"
alias open=xdg-open
alias rm=trash
alias unrar=unrar-free
alias ssh="$SSH_COMMAND"
alias streamlink="streamlink --player=mpv"
alias scanimage=" \
  scanimage \
    --device=$SANE_DEFAULT_DEVICE \
    -x210 \
    -y297 \
    --resolution=300 \
    --format=pdf \
    --progress \
"

gdiff() {
  git diff $@ --name-only |
    fzf -m --ansi --preview "git diff $@ --color=always -- {-1}"
}
