#!/bin/sh

export XDG_CONFIG_HOME=$HOME/.config
export XDG_CACHE_HOME=$HOME/.cache
export XDG_DATA_HOME=$HOME/.local/share

source $XDG_CONFIG_HOME/user-dirs.dirs
export XDG_DESKTOP_DIR
export XDG_DOCUMENTS_DIR
export XDG_DOWNLOAD_DIR
export XDG_MUSIC_DIR
export XDG_PICTURES_DIR
export XDG_SCREENSHOTS_DIR
export XDG_PUBLICSHARE_DIR
export XDG_TEMPLATES_DIR
export XDG_VIDEOS_DIR

export BROWSER=/usr/bin/floorp
export EDITOR=/usr/bin/helix
export VISUAL=/usr/bin/helix
export TERMINAL=/usr/bin/foot

export SCREEN_RECORDS_DIR=$XDG_VIDEOS_DIR/screen-records
export KEYS_DIR=$HOME/keys
export PROJECTS_DIR=$HOME/projects

export DOTFILES=$PROJECTS_DIR/paemuri/dotfiles

export GRIM_DEFAULT_DIR=$XDG_SCREENSHOTS_DIR

export GNUPGHOME=$KEYS_DIR/gnupg
export SSH_CONFIG=$KEYS_DIR/ssh/config

export SSH_COMMAND="ssh -F $SSH_CONFIG"
export RSYNC_RSH="$SSH_COMMAND"
export GIT_SSH_COMMAND="$SSH_COMMAND"

export RUSTUP_HOME=$XDG_DATA_HOME/rustup
export CARGO_HOME=$XDG_DATA_HOME/cargo
export CARGO_NAME="Rafael Escobar"
export CARGO_EMAIL=rescobar@pm.me

export NODE_REPL_HISTORY=$XDG_DATA_HOME/node/repl-history
export NPM_CONFIG_USERCONFIG=$XDG_CONFIG_HOME/npm/config
export VOLTA_HOME=$XDG_DATA_HOME/volta

export GOPATH=$XDG_DATA_HOME/go

export HISTFILE=$XDG_DATA_HOME/bash/history
export HISTCONTROL=ignoreboth:erasedups
export HISTFILESIZE=99999
export HISTSIZE=99999
export PROMPT_COMMAND="history -a"
export INPUTRC=$XDG_CONFIG_HOME/readline/inputrc

export XKB_DEFAULT_LAYOUT=br
export XKB_DEFAULT_OPTIONS=caps:escape

export XCURSOR_THEME=Simp1e
export XCURSOR_SIZE=24
export XCURSOR_PATH=$XDG_DATA_HOME/icons:/usr/share/icons

export SDL_VIDEODRIVER=wayland
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=river
export MOZ_ENABLE_WAYLAND=1

export LESSHISTFILE=$XDG_DATA_HOME/less/history
export LESSKEY=$XDG_CONFIG_HOME/less/keys

export PGSERVICEFILE=$XDG_CONFIG_HOME/postgresql/pg_service.conf
export PSQL_HISTORY=$XDG_DATA_HOME/psql/history

export SANE_DEFAULT_DEVICE=pixma:04A9183D_216141

export FZF_DEFAULT_COMMAND=fd
export FZF_CTRL_T_COMMAND=fd
export FZF_ALT_C_COMMAND="fd --type=d"

export WINEPREFIX=$XDG_DATA_HOME/wine

export MANGOHUD_CONFIGFILE=$XDG_CONFIG_HOME/mangohud/mangohud.conf

export WOBSOCK=$XDG_RUNTIME_DIR/wob.sock

export BEMENU_OPTS="\
  --ignorecase \
  --list=10 \
  --scrollbar=autohide \
  --prompt=search \
  --fn \"FiraMono 10\" \
  --line-height=20
  --tb=#282828 \
  --tf=#79740e \
  --fb=#282828 \
  --ff=#fdf4c1 \
  --nb=#282828 \
  --nf=#fdf4c1 \
  --hb=#282828 \
  --hf=#79740e \
  --sb=#282828 \
  --sf=#79740e \
  --scb=#282828 \
  --scf=#79740e \
"

# This forces Qt apps to use Adwaita Dark. I'll use it until I find a
# better style.
export QT_STYLE_OVERRIDE=Adwaita-Dark

export PATH=$HOME/.local/bin
PATH+=:$CARGO_HOME/bin
PATH+=:$VOLTA_HOME/bin
PATH+=:$GOPATH/bin
PATH+=:/opt
PATH+=:/usr/bin
PATH+=:/usr/local/bin
PATH+=:/usr/local/sbin
PATH+=:/usr/bin/vendor_perl
