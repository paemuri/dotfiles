#!/bin/sh

source ~/.config/bash/env

if test -z "$WAYLAND_DISPLAY" && test "$(tty)" = "/dev/tty1"
then
  mkdir -p $XDG_DATA_HOME/river/logs
  timestamp=$(date +%F-%H-%M-%S)
  exec dbus-run-session river -log-level info > \
    $XDG_DATA_HOME/river/logs/$timestamp.log 2>&1
fi

source $XDG_CONFIG_HOME/bash/prompt
source $XDG_CONFIG_HOME/bash/utils
source /usr/share/bash-completion/bash_completion
source /usr/share/nvm/init-nvm.sh

shopt -s \
  checkwinsize \
  cmdhist \
  dotglob \
  globstar \
  histappend

