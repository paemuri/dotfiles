#!/bin/bash

. "${XDG_CONFIG_HOME:-$HOME/.config}/bash/env"

if test -z "$WAYLAND_DISPLAY" && test "$(tty)" = "/dev/tty1"
then
  mkdir -p "$XDG_STATE_HOME/river/logs"
  prune-logs "$XDG_STATE_HOME/river/logs"
  timestamp=$(date +%F-%H-%M-%S)
  exec river -log-level info > "$XDG_STATE_HOME/river/logs/$timestamp.log" 2>&1
fi

# Everything below only matters for interactive shells.
case $- in
  *i*) ;;
  *)   return ;;
esac

. "$XDG_CONFIG_HOME/bash/prompt"
. "$XDG_CONFIG_HOME/bash/utils"

# Bash only.
. /usr/share/bash-completion/bash_completion
shopt -s \
  checkwinsize \
  cmdhist \
  globstar \
  histappend
