#!/bin/sh

reset="\033[m"
white="\033[38;2;253;244;193m"       # fdf4c1
green="\033[38;2;121;116;14m"        # 79740e
light_green="\033[38;2;184;187;38m"  # b8bb26
yellow="\033[38;2;181;118;20m"       # b57614
light_yellow="\033[38;2;250;189;47m" # fabd2f

prompt1() {

  path=$(pwd | sed "s|^$HOME|~|")
  echo -en "$green$(whoami)$white in $light_green$path$white"

  # Should be in a Git project.
  git_work_tree=$(git rev-parse --is-inside-work-tree 2> /dev/null)
  if test "$git_work_tree" != "true"
  then
    echo -en "$reset"
    return
  fi

  # Should have a current branch.
  git_branch=$( \
    git symbolic-ref --quiet --short HEAD 2> /dev/null || \
    git rev-parse --short HEAD 2> /dev/null)
  if test -z "$git_branch"
  then
    echo -en "$reset"
    return
  fi

  echo -en "$white on $light_yellow$git_branch$white"

  # Should not be in .git.
  git_dir=$(git rev-parse --is-inside-git-dir 2> /dev/null)
  if test "$git_dir" != "false"
  then
    echo -en "$reset"
    return
  fi

  git update-index --really-refresh -q &> /dev/null
  git_status=''

  if ! git diff --quiet --ignore-submodules --cached
  then
    git_status+="${yellow}stage"
  fi

  if ! git diff-files --quiet --ignore-submodules --
  then
    test -n "$git_status" && git_status+="$white and "
    git_status+="${yellow}changes"
  fi

  git_new_files=$(git ls-files --others --exclude-standard)
  if test -n "$git_new_files"
  then
    test -n "$git_status" && git_status+="$white and "
    git_status+="${yellow}new"
  fi

  if git rev-parse --verify refs/stash &> /dev/null
  then
    test -n "$git_status" && git_status+="$white and "
    git_status+="${yellow}stash"
  fi

  if test -n "$git_status"
  then
    echo -en " with $git_status$white"
  fi

  echo -en "$reset"
}

prompt2() {
  echo -en "→ "
}

export PS1="\n\$(prompt1)\n\$(prompt2)"
export PS2="\$(prompt2)"
