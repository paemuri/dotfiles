#!/bin/bash

reset=$(printf '\033[m')
white=$(printf '\033[38;2;253;244;193m')       # fdf4c1
green=$(printf '\033[38;2;121;116;14m')        # 79740e
light_green=$(printf '\033[38;2;184;187;38m')  # b8bb26
yellow=$(printf '\033[38;2;181;118;20m')       # b57614
light_yellow=$(printf '\033[38;2;250;189;47m') # fabd2f

# PS1 runs these in a subshell, so their variables never leak.

prompt1() {

  # Replace $HOME with ~ in $path.
  case $PWD in
    "$HOME"|"$HOME"/*) path="~${PWD#"$HOME"}" ;;
    *)                 path=$PWD ;;
  esac
  printf '%s' "$green$USER$white in $light_green$path$white"

  # Should be in a Git project and not in .git/. Also, $status will be used to
  # fetch more Git info.
  if ! status=$(git \
    --no-optional-locks \
    status \
    --porcelain=v2 \
    --branch \
    --ignore-submodules \
    2> /dev/null)
  then
    printf '%s' "$reset"
    return
  fi

  staged=''
  changed=''
  new=''
  # Lines look like `# branch.head main`, `? new-file` or `1 XY ...`, where X is
  # the staged state and Y the work tree state (`.` means unchanged).
  while read -r kind field value
  do
    case $kind in
      '#')
        case $field in
          branch.oid)  oid=$value ;;
          branch.head) branch=$value ;;
        esac
        ;;
      '?')
        new=1
        ;;
      1|2|u)
        case $field in [!.]?) staged=1 ;; esac
        case $field in ?[!.]) changed=1 ;; esac
        ;;
    esac
  done <<EOF
$status
EOF

  # Detached HEAD: show the short commit hash instead.
  if test "$branch" = '(detached)'
  then
    branch=$(printf '%.7s' "$oid")
  fi

  printf '%s' "$white on $light_yellow$branch$white"

  states=''
  test -n "$staged" && add_state stage
  test -n "$changed" && add_state changes
  test -n "$new" && add_state new
  git rev-parse --verify --quiet refs/stash > /dev/null && add_state stash

  if test -n "$states"
  then
    printf ' with %s' "$states$white"
  fi

  printf '%s' "$reset"
}

add_state() {
  states="${states:+$states$white and }$yellow$1"
}

prompt2() {
  printf '→ '
}

# Bash only: `\n` is a Bash prompt escape.
PS1='\n$(prompt1)\n$(prompt2)'
PS2='$(prompt2)'
