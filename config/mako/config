icons=0
markup=0
max-history=20

on-notify=exec mpv /usr/share/sounds/freedesktop/stereo/window-attention.oga

layer=overlay
font=Fira Mono 12

width=250
height=100
margin=5
padding=5
border-size=2
border-radius=0
