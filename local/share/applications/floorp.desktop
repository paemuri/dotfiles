[Desktop Entry]
Type=Application
Name=Floorp web browser - personal profile
GenericName=Web browser
TryExec=floorp
Exec=floorp %U
MimeType=application/x-extension-htm;application/x-extension-html;application/x-extension-shtml;application/x-extension-xht;application/x-extension-xhtml;application/xhtml+xml;text/html;x-scheme-handler/chrome;x-scheme-handler/http;x-scheme-handler/https;
