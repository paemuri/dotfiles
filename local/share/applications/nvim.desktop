[Desktop Entry]
Type=Application
Name=Neovim text editor
GenericName=Text editor
TryExec=nvim
Exec=foot -e nvim %u
MimeType=application/x-shellscript;text/css;text/csv;text/english;text/javascript;text/plain;text/x-c++;text/x-c++hdr;text/x-c++src;text/x-c;text/x-chdr;text/x-csrc;text/x-java;text/x-makefile;text/x-moc;text/x-pascal;text/x-tcl;text/x-tex;text/xml;
