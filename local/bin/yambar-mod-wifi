#!/bin/sh

last_text=""
last_symbol=""

while true
do

  info="$(iwctl station wlan0 show)"
  state="$(printf '%s\n' "$info" | sed -n 's/^ *State  *\(.*[^ ]\) *$/\1/p')"
  ssid="$(printf '%s\n' "$info" |
    sed -n 's/^ *Connected network  *\(.*[^ ]\) *$/\1/p')"

  text="$state"
  if test "$text" = "connected"
  then
    text="$ssid"
  fi

  symbol=""

  if test "$text" != "$last_text" || \
    test "$symbol" != "$last_symbol"
  then
    last_text="$text"
    echo "text|string|$text"
    last_symbol="$symbol"
    echo "symbol|string|$symbol"
    echo
  fi

  sleep 1s
done

