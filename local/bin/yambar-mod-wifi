#!/bin/sh

last_text=""
last_symbol=""

while true
do

  state="$(iwctl station wlan0 show | grep State | awk '{ print $2 }')"
  ssid="$(iwctl station wlan0 show | grep network | awk '{ print $3 }')"

  text="$state"
  if test "$text" = "connected"
  then
    text="$ssid"
  fi

  symbol=""

  if test "$text" != "$last_text" || \
    test "$symbol" != "$last_symbol"
  then
    last_text="$text"
    echo "text|string|$text"
    last_symbol="$symbol"
    echo "symbol|string|$symbol"
    echo
  fi

  sleep 1s
done

