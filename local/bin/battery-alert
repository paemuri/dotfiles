#!/bin/sh

help() {
  cat <<EOF
Notifies when the battery is low (15%) or critical (5%), once per level.

Usage: battery-alert [OPTION] CAPACITY IS_CHARGING

Options:
  -h, --help  Print this help and exit

Arguments:
  CAPACITY     Battery capacity, from 0 to 100
  IS_CHARGING  Either true or false
EOF
}

usage_error() {
  echo "battery-alert: $1" >&2
  echo "Run \`battery-alert --help\` for usage." >&2
  exit 2
}

#
# Arguments.
#

case $1 in
  -h|--help)
    help
    exit 0
    ;;
esac

capacity="$1"
is_charging="$2"

test -n "$capacity" || usage_error "missing capacity"
test "$capacity" -ge 0 2> /dev/null && test "$capacity" -le 100 ||
  usage_error "invalid capacity: $capacity (expected 0 to 100)"

test -n "$is_charging" || usage_error "missing is_charging"
case $is_charging in
  true|false) ;;
  *) usage_error "invalid is_charging: $is_charging (expected true or false)" ;;
esac

shift 2
test "$#" -eq 0 || usage_error "unknown arguments: $*"

#
# Cached last alert data.
#

cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/battery-alert"
test ! -e "$cache_dir" && mkdir -p "$cache_dir"
cache_path="$cache_dir/last-alert"
test ! -e "$cache_path" && touch "$cache_path"
last_alert="$(cat "$cache_path")"

#
# Alerts.
#

# Ignores and resets if charging.
if test "$is_charging" = "true"
then
  : > "$cache_path"
  exit 0
fi

# Resets if normal capacity.
if test "$last_alert" != "" && test "$capacity" -gt 15
then
  : > "$cache_path"
fi

# Alerts low if between 5-15.
if test "$last_alert" != "low" && \
  test "$capacity" -le 15 && \
  test "$capacity" -gt 5
then
  echo "low" > "$cache_path"
  notify-send -u critical \
    "Battery level is low!" \
    "Battery capacity at $capacity%. Consider charging the notebook."
fi

# Alerts critical if between 0-5.
if test "$last_alert" != "critical" && \
  test "$capacity" -le 5
then
  echo "critical" > "$cache_path"
  notify-send -u critical \
    "Battery level is critical!" \
    "Battery capacity at $capacity%! Charge the notebook now!"
fi
