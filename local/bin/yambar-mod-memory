#!/bin/sh

last_percent=""
last_usage=""

while true
do

  raw_output="$(free -m | sed '2!d' | awk '{print $2, $3}')"
  total="${raw_output% *}"
  usage="${raw_output#* }"
  percent="$(( usage * 100 / total ))"

  if [ "$percent" != "$last_percent" ] || [ "$usage" != "$last_usage" ]
  then
    last_percent="$percent"
    echo "percent|range:0-100|$percent"
    last_usage="$usage"
    echo "usage|int|$usage"
    echo
  fi

  sleep 1
done
