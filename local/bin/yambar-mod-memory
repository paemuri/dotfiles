#!/bin/sh

last_text=""
last_symbol=""

while true
do

  raw_output="$(free -m | sed -n '2p' | tr -s ' ' | cut -d' ' -f2,3)"
  total="${raw_output% *}"
  usage="${raw_output#* }"
  percent="$(( usage * 100 / total ))"
  text="$percent% ${usage}M"
  symbol=""

  if test "$text" != "$last_text" || \
    test "$symbol" != "$last_symbol"
  then
    last_text="$text"
    echo "text|string|$text"
    last_symbol="$symbol"
    echo "symbol|string|$symbol"
    echo
  fi

  sleep 1
done
