#!/bin/sh

last_text=""
last_symbol=""

while true
do

  time="$(uptime | awk -F, '{ print $1 }' | sed 's/.* up //')"
  text="$time"
  symbol=""

  if test "$text" != "$last_text" || \
    test "$symbol" != "$last_symbol"
  then
    last_text="$text"
    echo "text|string|$text"
    last_symbol="$symbol"
    echo "symbol|string|$symbol"
    echo
  fi

  sleep 60
done
