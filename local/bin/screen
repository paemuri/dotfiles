#!/bin/sh

help() {
  cat <<'EOF'
Takes screenshots and screen recordings.

Usage: screen [OPTION]... COMMAND

Commands:
  shot    Take a screenshot (saved to $XDG_SCREENSHOTS_DIR)
  record  Start a screen recording, or stop the one in progress (saved to
          $SCREEN_RECORDS_DIR)

Options:
  -h, --help  Print this help and exit
  -c, --crop  Select an area first
  -C, --copy  Copy the screenshot to the clipboard instead of saving it
EOF
}

usage_error() {
  echo "screen: $1" >&2
  echo "Run \`screen --help\` for usage." >&2
  exit 2
}

geometry=""

state_home=${XDG_STATE_HOME:-$HOME/.local/state}/screen
if ! test -d $state_home/logs
then
  mkdir -p $state_home/logs
fi

select_geometry() {
  if test "$1" = 1
  then
    # Cancelled selection (Esc): stop instead of capturing the whole screen.
    geometry="$(slurp)" || exit 1
  fi
}

cmd_record() {

  crop="$1"

  pid_file=$XDG_RUNTIME_DIR/wf-recorder.pid

  current_pid=$(cat "$pid_file" 2>/dev/null)
  if test -n "$current_pid" && kill -0 "$current_pid" 2>/dev/null
  then
    kill -s INT "$current_pid"
    rm "$pid_file"
    sleep 1
    notify-send "Record saved"
    exit
  fi

  select_geometry "$crop"

  current_date=$(date +%Y-%m-%d-%H-%M-%S)
  record_file=$SCREEN_RECORDS_DIR/$current_date.mp4
  log_file=$state_home/logs/$current_date.log
  wf-recorder ${geometry:+-g "$geometry"} -f$record_file > $log_file 2>&1 &

  current_pid=$!
  echo "$current_pid" > "$pid_file"
}

cmd_shot() {

  copy="$1"
  crop="$2"
  msg=""

  select_geometry "$crop"

  if test "$copy" = 1
  then
    grim ${geometry:+-g "$geometry"} - | wl-copy
    msg="copied"
  else
    grim ${geometry:+-g "$geometry"}
    msg="saved"
  fi

  sleep 1
  notify-send "Screenshot $msg"
}

main() {

  # Args.

  crop=0
  copy=0
  cmd=""

  while test "$#" -gt 0
  do

    opt="$1"
    shift

    case $opt in
      # Options.
      -h|--help)
        help
        exit 0
        ;;
      -c|--crop)
        crop=1
        ;;
      -C|--copy)
        copy=1
        ;;
      -*)
        usage_error "unknown option: $opt"
        ;;
      # Commands.
      record|shot)
        cmd=$opt
        ;;
      *)
        usage_error "unknown command: $opt (expected shot or record)"
        ;;
    esac
  done

  test -n "$cmd" || usage_error "missing command"

  # Main.

  case $cmd in
    record)
      cmd_record "$crop"
      ;;
    shot)
      cmd_shot "$copy" "$crop"
      ;;
  esac
}

main "$@"
