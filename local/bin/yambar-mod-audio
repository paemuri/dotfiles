#!/bin/sh

last_text=""
last_symbol=""

while true
do

  volume="$(ponymix --output get-volume)"
  text="$volume"
  if ponymix --output is-muted
  then
    symbol=""
  elif test "$volume" -eq 0
  then
    symbol=""
  elif test "$volume" -lt 50
  then
    symbol=""
  else
    symbol=""
  fi

  if test "$text" != "$last_text" || \
    test "$symbol" != "$last_symbol"
  then
    last_text="$text"
    echo "text|string|$text"
    last_symbol="$symbol"
    echo "symbol|string|$symbol"
    echo
  fi

  sleep 1s
done
