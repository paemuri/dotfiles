#!/bin/sh

cmd=$1
if test "$cmd" = ""
then
  echo    "Missing command." >&2
  echo    "Command should be:" >&2
  echo -e "\tpritunl-all <command>" >&2
  exit 1
fi

all_ids=$( \
  pritunl-client list | \
  tail --lines=+4 | \
  head --lines=-1 | \
  awk '{ print $2 }' \
)

for id in $all_ids
do
  pritunl-client $cmd $id
done
