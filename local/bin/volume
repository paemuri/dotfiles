#!/bin/sh

help() {
  cat <<'EOF'
Changes the volume of the default output or input, and shows it in wob.

Usage: volume [OPTION] DEVICE ACTION

Options:
  -h, --help  Print this help and exit

Arguments:
  DEVICE  input or output
  ACTION  increase or decrease (by 10%, up to 150%), or mute (toggle)
EOF
}

usage_error() {
  echo "volume: $1" >&2
  echo "Run \`volume --help\` for usage." >&2
  exit 2
}

case $1 in
  -h|--help)
    help
    exit 0
    ;;
esac

device="$1"
cmd="$2"

test -n "$device" || usage_error "missing device"
case $device in
  input|output) ;;
  *) usage_error "invalid device: $device (expected input or output)" ;;
esac

test -n "$cmd" || usage_error "missing action"
case $cmd in
  increase|decrease|mute) ;;
  *) usage_error "invalid action: $cmd (expected increase, decrease or mute)" ;;
esac

shift 2
test "$#" -eq 0 || usage_error "unknown arguments: $*"

ponymix_args=""
if [ "$cmd" = "mute" ]
then
  ponymix_args="toggle"
else
  ponymix_args="--max-volume=150 $cmd 10"
fi

val=$(ponymix --$device $ponymix_args)
col=$(ponymix --$device is-muted && echo muted)
echo $val $col > $WOBSOCK
