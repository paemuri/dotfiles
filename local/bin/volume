#!/bin/sh

device="$1"
if [ "$device" = "" ]
then
  echo    "Missing device." >&2
  echo    "Command should be:" >&2
  echo -e "\tvolume (input|output) (increase|decrease|mute)" >&2
  exit 1
fi
if [ "$device" != "input" ] && [ "$device" != "output" ]
then
  echo    "Invalid argument: $device." >&2
  echo    "Command should be:" >&2
  echo -e "\tvolume (input|output) (increase|decrease|mute)" >&2
  exit 1
fi

cmd="$2"
if [ "$cmd" = "" ]
then
  echo    "Missing cmd." >&2
  echo    "Command should be:" >&2
  echo -e "\tvolume (input|output) (increase|decrease|mute)" >&2
  exit 1
fi
if [ "$cmd" != "increase" ] && [ "$cmd" != "decrease" ] && [ "$cmd" != "mute" ]
then
  echo    "Invalid argument: $cmd." >&2
  echo    "Command should be:" >&2
  echo -e "\tvolume (input|output) (increase|decrease|mute)" >&2
  exit 1
fi

ponymix_args=""
if [ "$cmd" = "mute" ]
then
  ponymix_args="toggle"
else
  ponymix_args="--max-volume=150 $cmd 10"
fi

val=$(ponymix --$device $ponymix_args)
col=$(ponymix --$device is-muted && echo $WOB_ERR || echo $WOB_OK)
echo $val $col > $WOBSOCK
