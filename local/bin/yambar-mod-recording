#!/bin/sh

# Anything different than empty to force it to be written in the first
# iteration.
last_symbol=$(uuidgen)

while true
do

  pid_file=$XDG_RUNTIME_DIR/wf-recorder.pid
  current_pid=$(cat "$pid_file" 2>/dev/null)

  symbol=""
  if test -n "$current_pid" && kill -0 "$current_pid" 2>/dev/null
  then
    symbol=""
  fi

  if test "$symbol" != "$last_symbol"
  then
    last_symbol="$symbol"
    echo "symbol|string|$symbol"
    echo
  fi

  sleep 1
done
