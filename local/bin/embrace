#!/bin/sh

help() {
  cat <<'EOF'
Turns every line of a file into an SQL tuple or a JSON array.

Usage: embrace [OPTION]... [FILE]

Options:
  -h, --help  Print this help and exit
      --sql   Output an SQL tuple, like ('a','b') (default)
      --json  Output a JSON array, like ["a","b"]

Arguments:
  FILE  File to read (default: standard input)
EOF
}

usage_error() {
  echo "embrace: $1" >&2
  echo "Run \`embrace --help\` for usage." >&2
  exit 2
}

output=sql
file=/dev/stdin

while test "$#" -gt 0
do

  opt="$1"
  shift

  case $opt in
    -h|--help)
      help
      exit 0
      ;;
    --sql)
      output=sql
      ;;
    --json)
      output=json
      ;;
    -*)
      usage_error "unknown option: $opt"
      ;;
    *)
      if ! test -f "$opt"
      then
        echo "embrace: $opt: no such file" >&2
        exit 1
      fi
      file=$opt
      ;;
  esac
done

open=
close=
quote=
case $output in
  sql)
    open='('
    close=')'
    quote="'"
    ;;
  json)
    open='['
    close=']'
    quote='"'
    ;;
esac

sed "s|$|$quote,$quote|" < "$file" |
  tr -d "\n" |
  sed "s|,$quote$|$close|" |
  sed "s|^|$open$quote|"
