#!/bin/sh

last_text=""
last_symbol=""

while true
do

  temp="$(( $(cat /sys/class/thermal/thermal_zone0/temp) / 1000 ))"
  text="$temp°C"
  symbol=""

  if test "$text" != "$last_text" || \
    test "$symbol" != "$last_symbol"
  then
    last_text="$text"
    echo "text|string|$text"
    last_symbol="$symbol"
    echo "symbol|string|$symbol"
    echo
  fi

  sleep 1s
done
