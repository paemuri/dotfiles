#!/bin/sh

device_name="BAT1"

last_state=""
last_capacity=""
last_charging=""

while true
do

  state="$(tr '[:upper:]' '[:lower:]' < /sys/class/power_supply/$device_name/status)"
  capacity="$(cat /sys/class/power_supply/$device_name/capacity)"
  charging="false"
  if [ "$state" = "full" ] || [ "$state" = "charging" ]
  then
    charging="true"
  fi

  if [ "$state" != "$last_state" ] || \
    [ "$capacity" != "$last_capacity" ] || \
    [ "$charging" != "$last_charging" ]
  then
    last_state="$state"
    echo "state|string|$state"
    last_capacity="$capacity"
    echo "capacity|range:0-100|$capacity"
    last_charging="$charging"
    echo "charging|bool|$charging"
    echo
  fi

  battery-alert "$capacity" "$charging"

  sleep 1
done
