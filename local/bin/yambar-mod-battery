#!/bin/sh

device_name="BAT1"

last_text=""
last_symbol=""

while true
do

  state="$(tr '[:upper:]' '[:lower:]' < /sys/class/power_supply/$device_name/status)"
  capacity="$(cat /sys/class/power_supply/$device_name/capacity)"
  text="$capacity%"

  symbol=""
  charging="true"
  if test "$state" = "discharging"
  then
    charging="false"
    if test "$capacity" -le 20
    then
      symbol=""
    elif test "$capacity" -le 40
    then
      symbol=""
    elif test "$capacity" -le 60
    then
      symbol=""
    elif test "$capacity" -le 80
    then
      symbol=""
    else
      symbol=""
    fi
  fi

  battery-alert "$capacity" "$charging"

  if test "$text" != "$last_text" || \
    test "$symbol" != "$last_symbol"
  then
    last_text="$text"
    echo "text|string|$text"
    last_symbol="$symbol"
    echo "symbol|string|$symbol"
    echo
  fi

  sleep 1
done
