#!/bin/sh

set -e

# Log transfers.
log_dir=${XDG_STATE_HOME:-$HOME/.local/state}/backup-sync
mkdir -p "$log_dir"
# Delete logs older than 30 days.
find "$log_dir" -name '*.log' -mtime +30 -exec rm -f {} +
log_file="$log_dir/$(date +%Y-%m-%d-%H-%M-%S).log"
echo "Logging to $log_file"

exec > "$log_file" 2>&1

for dir in \
  keys \
  documents \
  audios \
  media \
  miscellaneous \
  gallery
do
  echo "Syncing $dir..."
  rclone bisync ~/$dir/ proton:/$dir/ \
    --resilient \
    --recover \
    --max-lock 2m \
    --conflict-resolve newer \
    --conflict-loser num \
    --protondrive-replace-existing-draft=true \
    --verbose \
    "$@"
  echo "Synced $dir."
  echo
done
