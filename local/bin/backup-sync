#!/bin/sh

set -e

# Log transfers.
log_dir=${XDG_STATE_HOME:-$HOME/.local/state}/backup-sync
mkdir -p "$log_dir"
prune-logs "$log_dir"
log_file="$log_dir/$(date +%Y-%m-%d-%H-%M-%S).log"
echo "Logging to $log_file"

exec > "$log_file" 2>&1

# keys is copied, not synced, to prevent retarded overwrites. Also, GnuPG junk
# is ignored.
echo "Syncing keys..."
rclone copy ~/keys/ proton:/keys/ \
  --exclude 'gnupg/.#lk*' \
  --exclude 'gnupg/S.*' \
  --exclude 'gnupg/random_seed' \
  --protondrive-replace-existing-draft=true \
  --verbose \
  "$@"
echo "Synced keys."
echo

for dir in \
  documents \
  audios \
  media \
  miscellaneous \
  gallery
do
  echo "Syncing $dir..."
  rclone bisync ~/$dir/ proton:/$dir/ \
    --resilient \
    --recover \
    --max-lock 2m \
    --conflict-resolve newer \
    --conflict-loser num \
    --protondrive-replace-existing-draft=true \
    --verbose \
    "$@"
  echo "Synced $dir."
  echo
done
