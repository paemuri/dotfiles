#!/bin/sh

set -e

regex() {
  echo "$1" | pcre2grep "$2" >/dev/null
}

get_timestamp() {

  local filepath="$1"

  # Tries to parse the creation time from exiftool.
  local exif_creation_time=$( \
    exiftool "$filepath" | \
    grep -i 'create date' | \
    head -1 | \
    cut -d : -f 2- | \
    awk '{ $1=$1; print }' \
  )
  local timestamp=$( \
    echo "$exif_creation_time" | \
    tr -d ': ' \
  )

  # Fix left padding zeros.
  if test "${#timestamp}" -gt 0 && \
    test "${#timestamp}" -lt 14
  then
    timestamp=''
    for d in $( \
      echo "$exif_creation_time" | \
      tr : ' ' | \
      tr ' ' \n \
    )
    do
      timestamp+=$(printf "%02d" "$d")
    done
  fi

  # Then, tries to parse the creation time from the filepath name.
  if test -z "$timestamp" || \
    test "$timestamp" = "00000000000000" || \
    test "$timestamp" = "20021208120000" # ???
  then

    timestamp=''
    local fname="${file%.*}" # Removes extension.
    
    if regex "$fname" '^(img|vid)-\d{1,13}-\d{3}$'
    then
      timestamp=$( \
        echo "$fname" | \
	cut -d - -f 2 \
      )

    elif regex "$fname" '^\d{8}_\d{6}_0( \(\d\))?$'
    then
      timestamp=$( \
        echo "$fname" | \
        cut -d _ -f 1-2 | \
        tr -d _ \
      )

    elif regex "$fname" '^\w{3}_\d{8}_\d{6}.*$'
    then
      timestamp=$( \
        echo "$fname" | \
        cut -d _ -f 2-3 | \
        tr -d _ \
      )

    elif regex "$fname" '^\w{3}-\d{8}-WA\d{4}.*$'
    then
      timestamp=$( \
        echo "$fname" | \
        cut -d - -f 2 | \
        tr -d _ \
      )
    
    elif regex "$fname" '^photo_\d{4}-\d{2}-\d{2}_\d{2}-\d{2}-\d{2}( \(\d+\))?$'
    then
      timestamp=$( \
        echo "$fname" | \
        cut -d _ -f 2- | \
        cut -d ' ' -f 1 | \
        tr -d '_-' \
      )
    
    elif regex "$fname" '^WhatsApp Image \d{4}-\d{2}-\d{2} at \d{2}.\d{2}.\d{2}( \(\d\))?$'
    then
      timestamp=$( \
        echo "$fname" | \
        cut -d ' ' -f 3,5 | \
        tr -d '.- ' \
      )

    elif regex "$fname" '^signal-\d{4}-\d{2}-\d{2}-\d{6}( .*)?$'
    then
      timestamp=$( \
        echo "$fname" | \
        cut -d - -f 2- | \
	cut -d ' ' -f 1 | \
	tr -d - \
      )

    fi

  fi

  # Limits to 14 chars.
  timestamp=$( \
    echo "$timestamp" | \
    cut -b 1-14 \
  )

  # Fix missing time by padding right with zeroes.
  while test "${#timestamp}" -gt 0 && \
    test "${#timestamp}" -lt 14
  do
    timestamp+="0"
  done

  # Prints value to return it.
  echo "$timestamp"
}

rename() {

  local filepath="$1"
  local dir=$(dirname "$filepath")
  local file=$(basename "$filepath")
  local format="$2"
  local prefix="$3"

  # Ignores the ones that were already fixed.
  if regex "$file" $prefix'-\d{14}-\d{3}\.'$format
  then
    return
  fi

  # Gets the file's timestamp.
  local timestamp=$(get_timestamp "$filepath")

  # Validates if could not fix the name.
  if test -z "$timestamp"
  then
    echo "$filepath: could not fix" >&2 
    return
  fi

  # Create unique new filepath.
  local new_filepath=''
  local suffix="001"
  while new_filepath="$dir/$prefix-$timestamp-$suffix.$format" && \
    test -f "$new_filepath"
  do
    suffix=$(printf "%03d" $(( 10#$suffix + 1 )))
  done

  echo "$filepath → $new_filepath"
  mv "$filepath" "$new_filepath"
  touch -t $(echo "$timestamp" | sed 's/./&./12') "$new_filepath"
}

tmp_ifs="$IFS"
IFS='
'

for filepath in $(find $@ -iname  '*.jpg' -o -iname '*.jpeg')
do
  rename "$filepath" jpg img
done

for filepath in $(find $@ -iname  '*.png')
do
  rename "$filepath" png img
done

for filepath in $(find $@ -iname  '*.mp4')
do
  rename "$filepath" mp4 vid
done

for filepath in $(find $@ -iname  '*.mov')
do
  rename "$filepath" mov vid
done

IFS="$tmp_ifs"
