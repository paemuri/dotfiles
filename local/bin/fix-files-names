#!/bin/sh

set -e

help() {
  cat <<'EOF'
Renames photos and videos to img-/vid-<timestamp>-<n>.<ext>, taking the date
from their EXIF data or from their current name.

Usage: fix-files-names [OPTION] DIR...

Options:
  -h, --help  Print this help and exit
EOF
}

usage_error() {
  echo "fix-files-names: $1" >&2
  echo "Run \`fix-files-names --help\` for usage." >&2
  exit 2
}

case $1 in
  -h|--help)
    help
    exit 0
    ;;
esac

# Without arguments, find would rename everything under the current directory.
test "$#" -gt 0 || usage_error "missing directory"
for dir in "$@"
do
  test -d "$dir" || usage_error "not a directory: $dir"
done

exit_code=0

regex() {
  echo "$1" | pcre2grep "$2" >/dev/null
}

get_timestamp() {

  filepath="$1"

  # Tries to parse the creation time from exiftool.
  exif_creation_time=$( \
    exiftool "$filepath" | \
    grep -i 'create date' | \
    head -1 | \
    cut -d : -f 2- | \
    awk '{ $1=$1; print }' \
  )
  timestamp=$( \
    echo "$exif_creation_time" | \
    tr -d ': ' \
  )

  # Fix left padding zeros.
  if test "${#timestamp}" -gt 0 && \
    test "${#timestamp}" -lt 14
  then
    timestamp=''
    for d in $( \
      echo "$exif_creation_time" | \
      tr : ' ' | \
      tr ' ' '\n' \
    )
    do
      timestamp="$timestamp$(printf "%02d" "${d#0}")"
    done
  fi

  # Then, tries to parse the creation time from the filepath name.
  if test -z "$timestamp" || \
    test "$timestamp" = "00000000000000" || \
    test "$timestamp" = "20021208120000" # ???
  then

    timestamp=''
    fname="${file%.*}" # Removes extension.

    # Incomplete ones (still needed?)
    if regex "$fname" '^(img|vid)-\d{1,13}-\d{3}$'
    then
      timestamp=$( \
        echo "$fname" | \
        cut -d - -f 2 \
      )

    # 19990101_121212_0
    # 19990101_121212_0 (0)
    # XXX_19990101_121212
    # photo_1999-01-01_12-12-12
    # photo_1999-01-01_12-12-12 (000)
    # signal-1999-01-01-121212
    # signal-1999-01-01-12-12-12-000
    # IMG_19990101_1212120
    elif regex "$fname" '[^\d]\d{4}-?\d{2}-?\d{2}[_-]\d{2}[.-]?\d{2}[.-]?\d{2}'
    then
      timestamp=$( \
        echo "$fname" | \
        sed -r 's/^.*([0-9]{4}-?[0-9]{2}-?[0-9]{2}[_-][0-9]{2}[.-]?[0-9]{2}[.-]?[0-9]{2}).*$/\1/' | \
        tr -d '._-'
      )

    # Whatsapp Image 1999-01-01 at 12.12.12
    # Screen Shot 1999-01-01 at 12.12.12
    elif regex "$fname" '\d{4}-\d{2}-\d{2} at \d{2}.\d{2}.\d{2}'
    then
      timestamp=$( \
        echo "$fname" | \
        sed -r 's/^.*([0-9]{4}-[0-9]{2}-[0-9]{2} at [0-9]{2}.[0-9]{2}.[0-9]{2}).*$/\1/' | \
        sed -r 's/ at //' | \
        tr -d '._-'
      )

    # ?
    elif regex "$fname" '^\w{3}-\d{8}-WA\d{4}.*$'
    then
      timestamp=$( \
        echo "$fname" | \
        cut -d - -f 2 | \
        tr -d _ \
      )

    fi

  fi

  # Limits to 14 chars.
  timestamp=$( \
    echo "$timestamp" | \
    cut -b 1-14 \
  )

  # Fix missing time by padding right with zeroes.
  while test "${#timestamp}" -gt 0 && \
    test "${#timestamp}" -lt 14
  do
    timestamp="${timestamp}0"
  done

  # Prints value to return it.
  echo "$timestamp"
}

rename() {

  filepath="$1"
  dir=$(dirname "$filepath")
  file=$(basename "$filepath")
  format="$2"
  prefix="$3"

  # Ignores the ones that were already fixed.
  if regex "$file" $prefix'-\d{14}-\d{3}\.'$format
  then
    return
  fi

  # Gets the file's timestamp.
  timestamp=$(get_timestamp "$filepath")

  # Validates if could not fix the name.
  if test -z "$timestamp"
  then
    echo "fix-files-names: $filepath: could not fix" >&2
    exit_code=1
    return
  fi

  # Create unique new filepath.
  new_filepath=''
  n=1
  while suffix=$(printf "%03d" "$n") && \
    new_filepath="$dir/$prefix-$timestamp-$suffix.$format" && \
    test -f "$new_filepath"
  do
    n=$((n + 1))
  done

  echo "$filepath → $new_filepath"
  mv "$filepath" "$new_filepath"
  touch -t "$(echo "$timestamp" | sed 's/./&./12')" "$new_filepath"
}

tmp_ifs="$IFS"
IFS='
'

for filepath in $(find "$@" -iname  '*.jpg' -o -iname '*.jpeg')
do
  rename "$filepath" jpg img
done

for filepath in $(find "$@" -iname  '*.png')
do
  rename "$filepath" png img
done

for filepath in $(find "$@" -iname  '*.heic')
do
  rename "$filepath" heic img
done

for filepath in $(find "$@" -iname  '*.cr3')
do
  rename "$filepath" cr3 img
done

for filepath in $(find "$@" -iname  '*.gif')
do
  rename "$filepath" gif img
done

for filepath in $(find "$@" -iname  '*.webp')
do
  rename "$filepath" webp img
done

for filepath in $(find "$@" -iname  '*.mp4')
do
  rename "$filepath" mp4 vid
done

for filepath in $(find "$@" -iname  '*.mov')
do
  rename "$filepath" mov vid
done

IFS="$tmp_ifs"

exit "$exit_code"
