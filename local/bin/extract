case "$1" in
  *.tar.bz|*.tar.bz2|*.tbz|*.tbz2) tar xjvf "$1";;
  *.tar.gz|*.tgz) tar xzvf "$1";;
  *.tar.xz|*.txz) tar xJvf "$1";;
  *.zip) unzip "$1";;
  *.rar) unrar x "$1";;
  *.7z) 7z x "$1";;
  *)
    echo    "Missing archive file." >&2
    echo    "Command should be:" >&2
    echo -e "\textract <archive_file>" >&2
    exit 1
  ;;
esac
