#!/bin/sh

for file in "$@"
do
  echo "Extracting $file."
  case "$file" in
    *.tar.bz|*.tar.bz2|*.tbz|*.tbz2) tar -xjvf "$file";;
    *.tar.gz|*.tgz) tar -xzvf "$file";;
    *.tar.xz|*.txz) tar -xJvf "$file";;
    *.tar.zst) tar --zstd -xvf "$file";;
    *.zip) unzip "$file";;
    *.rar) unrar-free --extract "$file";;
    *.7z) 7z x "$file";;
    *)
      echo    "Invalid archive file: $file." >&2
      echo    "Command should be:" >&2
      echo -e "\textract <archive_file> [...<archive_file>]" >&2
      exit 1
    ;;
  esac
done
