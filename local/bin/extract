#!/bin/sh

help() {
  cat <<'EOF'
Extracts archives into the current directory.

Usage: extract [OPTION] FILE...

Options:
  -h, --help  Print this help and exit

Supported formats: .tar, .tar.bz(2), .tbz(2), .tar.gz, .tgz, .tar.xz, .txz,
.tar.zst, .gz, .bz2, .zip, .rar, .7z
EOF
}

usage_error() {
  echo "extract: $1" >&2
  echo "Run \`extract --help\` for usage." >&2
  exit 2
}

case $1 in
  -h|--help)
    help
    exit 0
    ;;
esac

test "$#" -gt 0 || usage_error "missing archive file"

# Keep going after a failure, like most Unix tools, but exit with 1 if any
# archive couldn't be extracted.
exit_code=0
for file in "$@"
do
  echo "Extracting $file."
  case "$file" in
    *.tar.bz|*.tar.bz2|*.tbz|*.tbz2) tar -xjvf "$file";;
    *.tar.gz|*.tgz) tar -xzvf "$file";;
    *.tar.xz|*.txz) tar -xJvf "$file";;
    *.tar.zst) tar --zstd -xvf "$file";;
    *.tar) tar -xvf "$file";;
    *.gz) gunzip "$file";;
    *.bz2) bunzip2 "$file";;
    *.zip) unzip "$file";;
    *.rar) unrar-free --extract "$file";;
    *.7z) 7z x "$file";;
    *)
      echo "extract: $file: unsupported archive format" >&2
      false
      ;;
  esac || exit_code=1
done

exit "$exit_code"
