#!/bin/sh

last_text=""
last_symbol=""

while true
do

  volume="$(ponymix --input get-volume)"
  text="$volume"
  if ponymix --input is-muted
  then
    symbol=""
  else
    symbol=""
  fi

  if test "$text" != "$last_text" || \
    test "$symbol" != "$last_symbol"
  then
    last_text="$text"
    echo "text|string|$text"
    last_symbol="$symbol"
    echo "symbol|string|$symbol"
    echo
  fi

  sleep 1
done
