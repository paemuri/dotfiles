#!/bin/sh

dotfiles="$(dirname $0)"
for dir in "config" "local/bin" "local/share/applications"
do
  mkdir -p ~/.$dir
  for file in $dotfiles/$dir/*
  do
    # ln -s "$file" ~/.$dir/
    cp -r $file ~/.$dir/
  done
done

echo "source ~/.config/bash/config" > ~/.bashrc
echo "source ~/.config/bash/config" > ~/.bash_profile

if test "$1" = "-i" || test "$1" = "--install"
then
    ${dotfiles}/local/bin/install-pkgs
fi

