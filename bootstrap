#!/bin/sh

dotfiles="$(dirname $0)"

for dir in \
  "config" \
  "local/bin" \
  "local/share/applications" \
  "local/share/packages"
do
  mkdir -p ~/.$dir
  for file in $dotfiles/$dir/*
  do
    ln -snfv "$(realpath "$file")" ~/.$dir/
  done
done

# Exceptions.
mkdir -p ~/.mozilla
ln -snfv "$(realpath $dotfiles/config/firefox)" ~/.mozilla/firefox

if test "$1" = "-i" || test "$1" = "--install"
then
  $dotfiles/local/bin/pkg-install
fi

if test -n "$MULLVAD_ACCOUNT_NUMBER" && \
  test "$(mullvad account get)" = "Not logged in on any account"
then
  mullvad account login $MULLVAD_ACCOUNT_NUMBER
fi