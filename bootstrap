#!/bin/sh

here="$(realpath "$(dirname "$0")")"
. "$here"/config/bash/env
test -r "$here"/config/bash/secret && . "$here"/config/bash/secret

for dir in \
  "config" \
  "local/bin" \
  "local/share/applications" \
  "local/share/packages"
do
  mkdir -p ~/."$dir"
  for item in "$here/$dir"/*
  do
    name="$(basename "$item")"
    test "$name" = README.md && continue # Ignore README.md.

    # ln would create the link inside a real directory instead of replacing it.
    target=~/."$dir/$name"
    if test -d "$target" && ! test -L "$target"
    then
      echo "Skipping $target: it's a real directory." >&2
      continue
    fi

    ln -snfv "$item" ~/."$dir"/
  done
done

# Exceptions; files located outside of XDG dirs.
mkdir -p ~/.floorp/personal
ln -snfv "$here"/config/floorp/installs.ini ~/.floorp/installs.ini
ln -snfv "$here"/config/floorp/profiles.ini ~/.floorp/profiles.ini
ln -snfv "$here"/config/floorp/personal/user.js ~/.floorp/personal/user.js
mkdir -p "$GNUPGHOME"
ln -snfv "$here"/config/gnupg/gpg-agent.conf "$GNUPGHOME"/gpg-agent.conf
ln -snfv "$here"/config/gnupg/gpg.conf "$GNUPGHOME"/gpg.conf

mkdir -p ~/downloads/torrents/results
mkdir -p ~/downloads/torrents/in-progress
mkdir -p "$XDG_SCREENSHOTS_DIR"
mkdir -p "$SCREEN_RECORDS_DIR"
mkdir -p "$(dirname "$NODE_REPL_HISTORY")"
mkdir -p "$(dirname "$HISTFILE")"
mkdir -p "$(dirname "$LESSHISTFILE")"
mkdir -p "$XDG_DATA_HOME"/mangohud

if test "$1" = "-i" || test "$1" = "--install"
then
  pkg-install
  rustup toolchain install stable
  volta install node npm
fi

if test -n "$MULLVAD_ACCOUNT_NUMBER" && \
  test "$(mullvad account get)" = "Not logged in on any account"
then
  mullvad account login "$MULLVAD_ACCOUNT_NUMBER"
  mullvad lockdown-mode set on
  mullvad auto-connect set on
  mullvad relay set location de
fi
